# --- Python build/cache artifacts ---
__pycache__/
*.pyc
.mypy_cache/

# --- Sphinx generated docs (regenerate from sphinx/source) ---
sphinx/build/
src/sn/help/

# --- Logs ---
*.log

# --- macOS / iCloud Drive sync noise ---
.DS_Store
.tmp.drivedownload/
.tmp.driveupload/

# --- Eclipse workspace-local settings (machine-specific) ---
.settings/

# --- Ad hoc scratch/test output left in the tree ---
# (uncomment any of these once you've confirmed they're throwaway, not fixtures)
*.xml
!/build.xml
*.json
*.snv
*.snm


# --- Example models (shipped with the app) are NOT scratch ---
!src/sn/examples/*.snm
!src/sn/examples/*.snv

# --- Packaging (ant: app, dmg, pyz) ---
/build/
/dist/
/.venv-build/
/archive/
/notes/
