        <property key="4938">
          <object type="sn.model.model.Node">
            <property key="db" ref="4914533376" />
            <property key="individual" type="bool" value="True" />
            <property key="attributes">
              <object type="util.persistence.serialize.strdict">
                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="The animation layout -- a &quot;physics&quot; layout: objects repel o…" />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="The animation layout -- a &quot;physics&quot; layout: objects repel one another like similarly charged&#10;particles, and relations pull what they connect together like elastic bands&#10;-- run as an animation, step by step, until nothing moves much (or it's&#10;stopped). Context windows move as wholes, carrying their contents, which&#10;are laid out inside them, each in its pane (see *Snapshot*).&#10;&#10;Each step's forces are calculated from a *Snapshot* of the graph (see&#10;*forces()*); here, on the GUI thread, a step at a time between Tk events (see&#10;*FieldsLayout_threaded* for doing it in a thread). The whole run is one&#10;undoable command.&#10;&#10;Use:&#10;&#10;  .. code-block:: python&#10;&#10;      f = FieldsLayout(view, ...)&#10;      f()        # start (or keep going)&#10;      f.kill()   # stop" />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
        </property>
