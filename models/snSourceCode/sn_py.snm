          <object type="sn.model.model.Node">
            <property key="db" ref="4914533376" />
            <property key="individual" type="bool" value="True" />
            <property key="attributes">
              <object type="util.persistence.serialize.strdict">
                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value" type="str" value="Implements a graphical editor for an *AttributedObject* of…" />
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="Implements a graphical editor for an *AttributedObject* of the form:&#10;&#10;+--------------------------------+&#10;| &lt;editor lines&gt; ...             |&#10;+--------------------------------+&#10;| [&lt;Message line&gt;]               |&#10;+--------------------------------+&#10;| [&lt;Answer line&gt;]                |&#10;+--------------------------------+&#10;| &lt;Add New Attribute button&gt;     |&#10;+--------------------------------+&#10;| &lt;Cancel button&gt;  &lt;Save button&gt; |&#10;+--------------------------------+&#10;&#10;where &lt;editor lines&gt; look like this:&#10;&#10;+------+---------+----------------+--------+--------+----------------------+&#10;|&lt;stat&gt;| &lt;label&gt; | &lt;value editor&gt; | &lt;type&gt; | &lt;note&gt; | &lt;button&gt; &lt;button&gt;... |&#10;+------+---------+----------------+--------+--------+----------------------+&#10;|&lt;stat&gt;| &lt;label&gt; | &lt;value editor&gt; | &lt;type&gt; | &lt;note&gt; | &lt;button&gt; &lt;button&gt;... |&#10;+------+---------+----------------+--------+--------+----------------------+&#10;&#10;If any attribute's name has a &quot;/&quot; in it, the lines are grouped by the parts of&#10;the names, like folders (see *treeOrder()*): each group has a header line with&#10;a triangle that collapses or expands it, and each attribute is labelled with&#10;just the last part of its name, indented under its group.&#10;&#10;The &lt;Message line&gt; and &lt;Answer iine&gt; are only visiable when the *setMessage()* &#10;or *ask()* methods are called." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
        </property>
