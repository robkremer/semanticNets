                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="What the parts of a graphical view share (*ViewBase*): the view&#10;(*sn.view.graphics.sngView.SNGView*) is made of parts -- mixins, each a module&#10;of its own (eg: *viewViewport* for zooming and scrolling) -- and this is what&#10;one part may use of the others, for the type checker: the attributes the view&#10;sets up (see *SNGView.__init__()*), and, declared only while type checking,&#10;the methods one part calls on another. At run time it adds nothing: each&#10;method is the part's own, found through the view's bases as before.&#10;&#10;While type checking, it's the view's own bases too (a graph of view objects,&#10;an observer of its model, dirtyable), so a part can use what they give (eg:&#10;*values()*, *setDirty()*, *url*).&#10;&#10;Created on Oct 18, 2026&#10;&#10;.. codeauthor:: Rob Kremer &lt;robkremer@me.com&gt;" />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
        </property>
