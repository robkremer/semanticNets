        <property key="5557">
          <object type="sn.model.model.Node">
            <property key="db" ref="4914533376" />
            <property key="individual" type="bool" value="True" />
            <property key="attributes">
              <object type="util.persistence.serialize.strdict">
                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="Join the trees related to one another (see *TREES*): a tree…" />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="Join the trees related to one another (see *TREES*): a tree whose root is&#10;related (see *related*) to a node in another tree becomes one of&#10;that node's children (the last) -- so it's laid out out beyond it, along&#10;the way out from the middle, rather than wherever it was. From the biggest&#10;top tree (one whose root isn't related to another tree), each tree related&#10;to one joined so far is joined to it (to the first node it's related to,&#10;in order of the relations made), and so on; then from the biggest of the&#10;rest (tops first). (Not a pinned root: it stays where&#10;it's been dropped.)&#10;&#10;:param roots: The trees' roots.&#10;:param kids: Each node's children: the joined trees' roots are added.&#10;:param pinned: The ids of the roots that are pinned (see *pins*).&#10;:param related: What each root is related to, and by what, in order (see&#10;  *TreeLayout.related()*: by the rows of the relation table that aren't&#10;  ignored). If None, by any relation shown (see *treeLayout.isLink()*).&#10;:returns: The roots of the trees there are now (in order); and each tree&#10;  joined: (the node it's joined to, its root, the relation between them --&#10;  or the relation type's link to its end: see *treeLayout.Terminal*)." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
        </property>
