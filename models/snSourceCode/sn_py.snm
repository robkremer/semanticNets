                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value" type="str" value="Parses the small HTML subset *ActionDialog* understands --…" />
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="Parses the small HTML subset *ActionDialog* understands -- ``&lt;b&gt;``/&#10;``&lt;strong&gt;``, ``&lt;i&gt;``/``&lt;em&gt;``, ``&lt;u&gt;``, ``&lt;br&gt;``, ``&lt;ol&gt;``/``&lt;ul&gt;``/&#10;``&lt;li&gt;``, plain text, and ``&lt;a id=&quot;...&quot;&gt;label&lt;/a&gt;`` action links -- into a&#10;flat list of *(text, styleTags, actionId)* runs.&#10;&#10;Anything outside that subset (unknown tags, attributes other than *id* on&#10;``&lt;a&gt;``) is silently ignored rather than raising: this is meant for small,&#10;hand-written strings composed by the caller, not for rendering arbitrary&#10;or untrusted HTML documents." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
