        <property key="7053">
          <object type="sn.model.model.Node">
            <property key="db" ref="4914533376" />
            <property key="individual" type="bool" value="True" />
            <property key="attributes">
              <object type="util.persistence.serialize.strdict">
                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="The File menu's *Close model*: close every window on *model…" />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="The File menu's *Close model*: close every window on *model* (offering&#10;to save each changed view, as closing them by hand does), offer to save the&#10;model if it's changed, and forget it -- so opening it again reads the file&#10;afresh. If that was the last window, the app quits, as it does when the&#10;last window is closed by hand.&#10;&#10;A model that other loaded models build on (eg: one of their types isa one&#10;of its) can't be closed: they'd be left pointing at it. Nothing is changed&#10;then.&#10;&#10;:param model: The model.&#10;:param askToSave: Whether to offer to save the model and its changed&#10;  views. False when they're being replaced (see *replacingModel()*).&#10;:param quitIfNone: Whether to quit if no window is left open. False when&#10;  another is about to be opened (see *replacingModel()*).&#10;:returns: Whether it was closed." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
        </property>
