            <property key="db" ref="4914533376" />
            <property key="individual" type="bool" value="True" />
            <property key="attributes">
              <object type="util.persistence.serialize.strdict">
                <property key="name">
                  <object type="util.attribute.Attribute">
                    <property key="value" type="str" value="Some widget inside this window just lost focus." />
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="Some widget inside this window just lost focus.&#10;&#10;This alone doesn't mean the *window* was deactivated -- moving focus&#10;between two widgets in the SAME window (e.g. tabbing fields) fires a&#10;FocusOut on the old one too. Defer the real check to *_checkStillActive()*&#10;via *after_idle()*, by which point the new focus owner (if any) has&#10;already been set, so *self.focus_get()* reliably reflects where focus&#10;actually ended up.&#10;&#10;:param event: The Tk event." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
                  </object>
                </property>
              </object>
            </property>
            <property key="inferred" type="bool" value="False" />
          </object>
