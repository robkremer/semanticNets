                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value="For *others* &quot;near&quot;: put each node in no tree near the tree nodes it's&#10;related to (by the rows of the relation table that aren't ignored: see&#10;*TreeLayout.related()*), in their tree, clear of its nodes and&#10;its relations' labels, with room for the label of the relation between&#10;them (see *placeNearGroups()*).&#10;&#10;:param groups: Where each tree's nodes' centres go, from its root: those put are added.&#10;:param others: The nodes in no tree.&#10;:param sizes: Every node's (width, height).&#10;:param edges: The tree relations (parent, child, relation).&#10;:returns: Those not put (related to no tree): for the rows." />
                    </property>
                    <property key="type" type="str" value="None" />
                    <property key="restriction" type="str" value="None" />
