                <property key="text">
                  <object type="util.attribute.Attribute">
                    <property key="value">
                      <object type="str" value=":returns: The value of string property *key* of the *section* (&quot;header&quot; or&#10;  &quot;root&quot;) of the document at *url* -- eg: (&quot;root&quot;, &quot;url&quot;) for a stored&#10;  PRDb's URL -- or None if there isn't one (or it isn't a string). Like&#10;  *peekType()*, nothing in the document is constructed.&#10;:param url:&#10;:type url: str&#10;:param section:&#10;:type section: str&#10;:param key:&#10;:type key: str&#10;:param mode:&#10;:type mode: str&#10;:param kwargs:&#10;:type kwargs:" />
